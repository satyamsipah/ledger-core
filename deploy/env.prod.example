# Copy this file to .env next to deploy/docker-compose.prod.yml, fill in
# real values, and keep it OFF version control (it already matches this
# repo's .gitignore pattern for .env*, but double-check before committing
# anything from a VPS you set this up on).
#
# Every variable here has no fallback in docker-compose.prod.yml on purpose
# -- `${VAR:?message}` makes `docker compose up` refuse to start rather than
# silently run with deploy/docker-compose.yml's well-known local password.

# --- Required, no safe default ---

# Postgres superuser password for the `ledger` role. Generate one; don't
# reuse a password from anywhere else.
POSTGRES_PASSWORD=

# The container registry and tag CI pushed this release to. TAG is normally
# a git tag (see .github/workflows/deploy.yml) -- pin it explicitly here
# rather than "latest", so a redeploy on this VPS is reproducible.
REGISTRY=ghcr.io/satyamsipah/ledger-core
TAG=

# The real external payment gateway's base URL. Never mock-gateway --
# that image is not part of this compose file at all, and mock-gateway's
# own comment in deploy/docker-compose.yml says LOCAL ONLY for a reason.
LEDGER_GATEWAY_URL=

# Grafana's admin password. GF_AUTH_ANONYMOUS_ENABLED is off in production
# regardless of this value -- see deploy/docker-compose.prod.yml.
GRAFANA_ADMIN_PASSWORD=

# --- Optional, sensible defaults in docker-compose.prod.yml ---

# GRAFANA_ADMIN_USER=admin
# LEDGER_POSTGRES_MAX_CONNS=20
# LEDGER_POSTGRES_MIN_CONNS=2
# LEDGER_RECONCILER_PSP_CSV_PATH=

# The hostname clients reach Redpanda's EXTERNAL listener on. Only matters
# if something outside this compose network needs to produce or consume
# directly; every service in this file talks to Redpanda over the internal
# listener regardless.
# LEDGER_PUBLIC_HOST=localhost
